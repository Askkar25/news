# OpenAI (used by src/scraper.js for relevance filtering, and later src/digest.js)
OPENAI_API_KEY=sk-...
OPENAI_FILTER_MODEL=gpt-4o-mini

# Cron schedule for the daily scrape (node-cron syntax). Default: 09:00 every day.
SCRAPE_CRON=0 9 * * *

# SMTP / email — used by the weekly digest mailer (src/digest.js, not yet built)
EMAIL_HOST=smtp.company.com
EMAIL_PORT=587
EMAIL_USER=your-email@company.com
EMAIL_PASS=your-password
EMAIL_FROM="Railway Digest <your-email@company.com>"
EMAIL_TO=colleague1@company.com,colleague2@company.com
